{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/.source": [
        "./.source"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "C:/Users/tjdvl/AppData/Local/Temp/next-portfolio/.next/types/**/*.ts",
    "next-env.d.ts",
    "C:\\Users\\tjdvl\\AppData\\Local\\Temp\\next-portfolio\\.next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".source"
  ]
}
